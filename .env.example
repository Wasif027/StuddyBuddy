# =============================================================================
# docker-compose environment — copy to .env
# =============================================================================
POSTGRES_DB=ekdp
POSTGRES_USER=ekdp
POSTGRES_PASSWORD=ekdp

# --- LLM synthesis (optional — leave as-is for free offline mode) --------
# Free generative answers via Groq: create a key at https://console.groq.com
LLM_PROVIDER=offline
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b
# OPENAI_API_KEY=gsk_...

# Or Anthropic (paid API):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Full backend config surface: backend/.env.example
