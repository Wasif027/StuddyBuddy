# =============================================================================
# Backend environment template — copy to backend/.env
# =============================================================================
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Data layer ------------------------------------------------------------
# Docker: use the compose default below. Local: paste your own Postgres+pgvector
# URL (a free Neon project works — change the prefix to postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://studybuddy:studybuddy@localhost:5432/studybuddy
REDIS_URL=redis://localhost:6379/0
AUTO_MIGRATE=true
# After any model change:  python -m app.core.database recreate   (drops all data)
#
# PRODUCTION: set AUTO_MIGRATE=false and run `python -m app.core.database init`
# once as a release step; use Neon's *pooled* URL with ?sslmode=require.

# --- Auth ------------------------------------------------------------------
# 32+ char random secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-0000000000000000
JWT_EXPIRE_HOURS=720

# --- Retrieval -----------------------------------------------------------
TOP_K_DEFAULT=8
RETRIEVAL_CANDIDATES=40
RERANK_ENABLED=true
MIN_EVIDENCE_SCORE=0.08
DOCUMENT_MODE_MAX_CHUNKS=40

# --- Uploads + vision ----------------------------------------------------
MAX_UPLOAD_BYTES=20000000
# Describe uploaded images (diagrams, slide photos, handwritten problems,
# timetables) with the vision model at ingest. Needs a vision-capable LLM.
VISION_ENABLED=true

# --- Tutor -------------------------------------------------------------
# Default explanation depth: simple | standard | deep | exam
DEFAULT_EXPLAIN_LEVEL=standard
# Default student level: year-8 | gcse | high-school | a-level | ib | undergraduate
DEFAULT_STUDY_LEVEL=high-school

# =============================================================================
# LLM + embeddings
# =============================================================================
# Everything defaults to FREE OFFLINE MODE (deterministic embeddings + extractive
# answers, no keys, no cost). For a proper demo, plug in one free provider.
#
# ---- Recommended: Google Gemini for BOTH (one free key, fast, has vision) ----
#   key: https://aistudio.google.com/apikey    (no credit card)
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-flash-latest
#   OPENAI_API_KEY=<your key>
#   HARD_MODEL=gemini-flash-latest        # or a Pro model for tougher grading
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_API_KEY=<your key>
#
# ---- Alternatives for the chat model ---------------------------------------
#   Groq   OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=openai/gpt-oss-20b
#   Ollama OPENAI_BASE_URL=http://localhost:11434/v1        OPENAI_MODEL=llama3.1   (local, no key)
#   Anthropic  LLM_PROVIDER=anthropic  ANTHROPIC_API_KEY=sk-ant-...   (paid API)

LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Stronger model for the brutal question + free-text grading (blank = use OPENAI_MODEL)
HARD_MODEL=
LLM_MAX_TOKENS=1600
LOW_CONFIDENCE_THRESHOLD=0.35

EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=768

# --- Caching / rate limiting ------------------------------------------------
CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=900
RATE_LIMIT_ENABLED=true
# A human asking questions won't hit 30/min; a runaway client loop will.
RATE_LIMIT_PER_MINUTE=30
# PRODUCTION (behind a load balancer): true → read the client IP from
# X-Forwarded-For so users don't share one rate-limit bucket.
TRUST_PROXY=false

# --- Observability -------------------------------------------------------
# leave empty locally; set to an OTLP HTTP endpoint in prod
OTLP_ENDPOINT=
# true dumps every span to the console — only for debugging tracing itself
OTEL_CONSOLE_EXPORT=false
LOG_LEVEL=INFO
LOG_JSON=false

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
