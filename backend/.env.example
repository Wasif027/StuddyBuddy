# =============================================================================
# Backend environment template — copy to backend/.env
# =============================================================================
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Data layer ------------------------------------------------------------
# Docker: use the compose default below. Local: paste your own Postgres+pgvector
# URL (a free Neon project works — change the prefix to postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://ekdp:ekdp@localhost:5432/ekdp
REDIS_URL=redis://localhost:6379/0
AUTO_MIGRATE=true
# After any model change:  python -m app.core.database recreate   (drops all data)
#
# PRODUCTION: set AUTO_MIGRATE=false and run `python -m app.core.database init`
# once as a release step; use Neon's *pooled* URL with ?sslmode=require.

# --- Auth ------------------------------------------------------------------
# 32+ char random secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-0000000000000000
JWT_EXPIRE_HOURS=720

# --- Retrieval -----------------------------------------------------------
TOP_K_DEFAULT=8
RETRIEVAL_CANDIDATES=40
RERANK_ENABLED=true
MIN_EVIDENCE_SCORE=0.08
DOCUMENT_MODE_MAX_CHUNKS=40

# --- Uploads + spreadsheet analytics -----------------------------------
MAX_UPLOAD_BYTES=15000000
ANALYSIS_MAX_ROWS=20000            # rows stored per sheet for text-to-SQL
ANALYSIS_RESULT_ROW_CAP=200        # rows returned from an analysis query
ANALYSIS_SQL_TIMEOUT_SECONDS=8

# =============================================================================
# LLM + embeddings
# =============================================================================
# Everything defaults to FREE OFFLINE MODE (deterministic embeddings + extractive
# answers, no keys, no cost). For a proper demo, plug in one free provider.
#
# ---- Recommended: Google Gemini for BOTH (one free key, fast, semantic) ------
#   key: https://aistudio.google.com/apikey    (no credit card)
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-flash-latest      # steadier citations/verdicts than -lite
#   OPENAI_API_KEY=<your key>
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_API_KEY=<your key>
#
# ---- Alternatives for the chat model ---------------------------------------
#   Groq   OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=openai/gpt-oss-20b
#   Ollama OPENAI_BASE_URL=http://localhost:11434/v1        OPENAI_MODEL=llama3.1   (local, no key)
#   Anthropic  LLM_PROVIDER=anthropic  ANTHROPIC_API_KEY=sk-ant-...   (paid API)

LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1400
LOW_CONFIDENCE_THRESHOLD=0.35

EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIM=768

# --- AI next-step suggestions ------------------------------------------
SUGGESTIONS_ENABLED=true
SUGGESTION_MAX_ALTERNATIVES=3     # alternatives offered per slot when the user keeps rejecting

# --- Caching / rate limiting ------------------------------------------------
CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=900
RATE_LIMIT_ENABLED=true
# A human asking questions won't hit 30/min; a runaway client loop will.
RATE_LIMIT_PER_MINUTE=30
# PRODUCTION (behind a load balancer): true → read the client IP from
# X-Forwarded-For so users don't share one rate-limit bucket.
TRUST_PROXY=false

# --- Observability -------------------------------------------------------
# leave empty for stdout span export; set to an OTLP HTTP endpoint in prod
OTLP_ENDPOINT=
OTEL_CONSOLE_EXPORT=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- CORS ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
